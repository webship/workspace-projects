{
  "name": "@webship.co/workspace-projects",
  "version": "1.0.2",
  "description": "The Projects workspace for Webship Workspace: the `projects/` folder (type sites), its settings file, its 14 commands and its docs, activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-projects.git"
  },
  "files": [
    "dist/src",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "projects",
    "label": "Projects",
    "workspace": {
      "key": "projects",
      "settingsTemplate": "config/workspace.projects.settings.yml",
      "files": [
        "commands/cmd-drupal11-recommended-project.sh",
        "commands/cmd-drupal12-recommended-project.sh",
        "commands/cmd-drupalcms2-x-project.sh",
        "commands/cmd-tool-backup-project.sh",
        "commands/cmd-tools-add-users.sh",
        "commands/cmd-tools-cancel-users.sh",
        "commands/cmd-tools-checks.sh",
        "commands/cmd-tools-clone.sh",
        "commands/cmd-tools-hostnames.sh",
        "commands/cmd-tools-reclaim.sh",
        "commands/cmd-tools-remove.sh",
        "commands/cmd-tools-screen.sh",
        "commands/cmd-tools-testing.sh",
        "commands/cmd-webships3-0-x-project.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "features": [
      "features/projects.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
